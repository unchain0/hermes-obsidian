---
services:
  gateway:
    image: "{{ hermes_image }}"
    restart: unless-stopped
    network_mode: host
{% if hermes_deployment_mode == "direct" %}
    env_file:
      - hermes.env
{% endif %}
    environment:
      HERMES_HOME: /opt/data
      OBSIDIAN_VAULT_PATH: /vault
      HERMES_UID: "{{ hermes_uid }}"
      HERMES_GID: "{{ hermes_gid }}"
    command: ["gateway", "run"]
    volumes:
      - "{{ hermes_root }}/home:/opt/data"
      - "{{ hermes_root }}/vault:/vault"
      - "{{ hermes_root }}/workspace:/workspace"
      - "{{ hermes_root }}/scripts:/opt/data/scripts"
    healthcheck:
      test: ["CMD", "hermes", "status"]
      interval: 60s
      timeout: 20s
      retries: 3
      start_period: 60s

{% if hermes_dashboard_enabled and hermes_deployment_mode == "direct" %}
  dashboard:
    image: "{{ hermes_image }}"
    restart: unless-stopped
    network_mode: host
    env_file:
      - hermes.env
    environment:
      HERMES_HOME: /opt/data
      HERMES_UID: "{{ hermes_uid }}"
      HERMES_GID: "{{ hermes_gid }}"
    command: ["dashboard", "--host", "127.0.0.1", "--no-open"]
    depends_on:
      gateway:
        condition: service_started
    volumes:
      - "{{ hermes_root }}/home:/opt/data"
      - "{{ hermes_root }}/vault:/vault"
      - "{{ hermes_root }}/workspace:/workspace"
{% endif %}

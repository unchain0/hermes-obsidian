---
services:
  gateway:
    image: "{{ hermes_image }}"
    restart: unless-stopped
    env_file:
      - hermes.env
    command: ["gateway", "run"]
    volumes:
      - "{{ hermes_root }}/home:/opt/data"
      - "{{ hermes_root }}/vault:/vault"
      - "{{ hermes_root }}/workspace:/workspace"
      - "{{ hermes_root }}/scripts:/opt/data/scripts"
    healthcheck:
      test: ["CMD", "hermes", "status"]
      interval: 60s
      timeout: 20s
      retries: 3
      start_period: 60s

{% if hermes_dashboard_enabled %}
  dashboard:
    image: "{{ hermes_image }}"
    restart: unless-stopped
    env_file:
      - hermes.env
    command: ["dashboard", "--host", "0.0.0.0", "--no-open"]
    depends_on:
      gateway:
        condition: service_started
    ports:
      - "{{ hermes_dashboard_bind }}:{{ hermes_dashboard_port }}:9119"
    volumes:
      - "{{ hermes_root }}/home:/opt/data"
      - "{{ hermes_root }}/vault:/vault"
      - "{{ hermes_root }}/workspace:/workspace"
{% endif %}
